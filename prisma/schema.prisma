generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum UserRole {
  MAIN_MANAGER
  SECRETARY_MANAGER
  SECRETARY_USER
  AUDIT_VIEWER
}

enum AuditStatus {
  SUCCESS
  FAILED
  SUSPICIOUS
}

enum FraudAlertLevel {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum BiometricStatus {
  SUCCESS
  FAILED
  SUSPICIOUS
}

enum TwoFactorAction {
  APPROVE_ORDER
  SUBMIT_COMMITMENT
  SUBMIT_ADDITIVE
}

enum OrderStatus {
  DRAFT
  OPEN
  IN_QUOTATION
  APPROVED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderCategory {
  MATERIAL
  SERVICE
  EQUIPMENT
}

enum ChatSenderType {
  PREFECTURE
  ESTABLISHMENT
}

enum TimelineStep {
  CREATED
  QUOTATION_OPENED
  QUOTATION_CLOSED
  APPROVED
  DELIVERED
  COMPLETED
  CANCELLED
}

// ============================================
// Models — Configuration
// ============================================

model BrandConfig {
  id               String   @id @default(uuid())
  logoUrl          String
  primaryColor     String   @default("#1E40AF")
  secondaryColor   String   @default("#1E3A8A")
  faviconUrl       String
  municipalityName String   @default("Prefeitura Municipal de Araçuaí")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================
// Models — Auth & Users
// ============================================

model User {
  id                String    @id @default(uuid())
  fullName          String
  birthDate         DateTime
  phone             String
  email             String    @unique
  cpf               String    @unique
  rg                String
  role              UserRole
  secretaryId       String?
  photoUrl          String?
  lastLogin         DateTime?
  biometricVerified Boolean   @default(false)
  documentVerified  Boolean   @default(false)
  passwordHash      String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions                 Session[]
  twoFactorRequests        TwoFactorRequest[]
  auditLogs                AuditLog[]
  biometricRecords         BiometricRecord[]
  createdOrders            Order[]            @relation("CreatedOrders")
  timelineEntries          OrderTimeline[]    @relation("TimelineUser")
  receivedDeliveries       DeliveryRecord[]   @relation("ReceivedDeliveries")
  registeredNonConformities NonConformity[]   @relation("RegisteredNonConformities")
  sentMessages             ChatMessage[]      @relation("SentMessages")

  @@index([email])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  refreshToken String   @unique
  expiresAt    DateTime
  ipAddress    String
  userAgent    String
  createdAt    DateTime @default(now())
}

model TwoFactorRequest {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  action       TwoFactorAction
  otpHash      String
  expiresAt    DateTime
  used         Boolean         @default(false)
  failCount    Int             @default(0)
  blockedUntil DateTime?
  createdAt    DateTime        @default(now())
}

// ============================================
// Models — Audit (Immutable)
// ============================================

model AuditLog {
  id         String      @id @default(uuid())
  action     String
  urlPath    String
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  userAgent  String
  ipAddress  String
  status     AuditStatus
  metadata   Json?
  occurredAt DateTime    @default(now())

  @@index([userId])
  @@index([status])
  @@index([occurredAt])
}

model BiometricRecord {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  capturedImageUrl String
  similarityScore  Float
  livenessScore    Float
  confidenceLevel  Float
  fraudAlertLevel  FraudAlertLevel
  aiEstimatedAge   Int?
  ipAddress        String
  status           BiometricStatus
  createdAt        DateTime        @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// Models — Secretarias
// ============================================

model Secretary {
  id                  String      @id @default(uuid())
  name                String      @unique
  phone               String
  cnpj                String      @unique
  description         String?
  secretaryPersonName String
  photoUrl            String?
  budgetAllocated     Float       @default(0)
  budgetUsed          Float       @default(0)
  parentId            String?
  parent              Secretary?  @relation("SubSecretaries", fields: [parentId], references: [id])
  subSecretaries      Secretary[] @relation("SubSecretaries")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  orders              Order[]     @relation("SecretaryOrders")
  subOrders           Order[]     @relation("SubSecretaryOrders")

  @@index([parentId])
}

// ============================================
// Models — Ordens de Serviço
// ============================================

model Order {
  id                   String        @id @default(uuid())
  code                 String        @unique
  name                 String
  category             OrderCategory
  status               OrderStatus   @default(DRAFT)
  secretaryId          String
  secretary            Secretary     @relation("SecretaryOrders", fields: [secretaryId], references: [id])
  subSecretaryId       String?
  subSecretary         Secretary?    @relation("SubSecretaryOrders", fields: [subSecretaryId], references: [id])
  investmentArea       String
  quotationStartDate   DateTime?
  quotationEndDate     DateTime?
  desiredDeliveryDate  DateTime?
  regionRadius         Int?
  specificMunicipality String?
  receiverName         String
  observations         String?
  createdByUserId      String
  createdBy            User          @relation("CreatedOrders", fields: [createdByUserId], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  items                OrderItem[]
  timeline             OrderTimeline[]
  deliveryRecords      DeliveryRecord[]
  nonConformities      NonConformity[]
  invoices             OrderInvoice[]
  chatMessages         ChatMessage[]
  deliveryLocations    DeliveryLocation[]

  @@index([secretaryId])
  @@index([status])
  @@index([createdByUserId])
  @@index([code])
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name           String
  imageUrl       String?
  unit           String
  quantity       Float
  referenceValue Float

  @@index([orderId])
}

model OrderTimeline {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  step       TimelineStep
  userId     String
  user       User         @relation("TimelineUser", fields: [userId], references: [id])
  occurredAt DateTime     @default(now())

  @@index([orderId])
}

model DeliveryRecord {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  images            String[]
  deliveredByUserId String?
  receivedByUserId  String
  receivedBy        User     @relation("ReceivedDeliveries", fields: [receivedByUserId], references: [id])
  deliveredAt       DateTime?
  receivedAt        DateTime @default(now())
  observations      String?

  @@index([orderId])
}

model NonConformity {
  id                 String   @id @default(uuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  images             String[]
  registeredByUserId String
  registeredBy       User     @relation("RegisteredNonConformities", fields: [registeredByUserId], references: [id])
  registeredAt       DateTime @default(now())
  observations       String

  @@index([orderId])
}

model OrderInvoice {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileUrl           String
  establishmentName String
  issuedAt          DateTime

  @@index([orderId])
}

model ChatMessage {
  id         String         @id @default(uuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User           @relation("SentMessages", fields: [senderId], references: [id])
  content    String?
  imageUrl   String?
  senderType ChatSenderType
  sentAt     DateTime       @default(now())

  @@index([orderId])
  @@index([sentAt])
}

model DeliveryLocation {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  zipCode String
  address String
  city    String
  state   String

  @@index([orderId])
}
