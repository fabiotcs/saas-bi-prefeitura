{
  "expo": {
    "name": "BI Araçuaí",
    "slug": "bi-aracuai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a56db"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.gov.aracuai.saasbi",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "O app usa a câmera frontal para verificação biométrica de identidade.",
        "NSFaceIDUsageDescription": "O app usa o Face ID para autenticação rápida e segura."
      }
    },
    "android": {
      "package": "br.gov.aracuai.saasbi",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a56db"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O app usa a câmera frontal para verificação biométrica de identidade."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O app usa o Face ID para autenticação rápida e segura."
        }
      ]
    ],
    "scheme": "bi-aracuai",
    "experiments": {
      "typedRoutes": true
    }
  }
}
